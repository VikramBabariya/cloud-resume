<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Professional Portfolio and Cloud Resume of {{ basics.name | e }}" />
    <title>{{ basics.name | e }} | {{ basics.label | e }}</title>
    
    <style>
      {{ inline_css }}
    </style>
  </head>
  <body>
    <main class="container">
      <header>
        <h1>{{ basics.name | e }}</h1>
        <h2>{{ basics.label | e }}</h2>
        <div class="contact-info">
          <p>
            {{ basics.email | e }} | 
            {{ basics.phone | default('', true) | e }} | 
            {{ basics.location.city | e }}, {{ basics.location.countryCode | e }}
          </p>
          <div class="profiles">
            {% for profile in basics.profiles %}
              <a href="{{ profile.url | e }}" target="_blank" rel="noopener noreferrer" 
                 class="{% if profile.network | lower == 'linkedin' %}btn btn-primary{% else %}btn btn-secondary{% endif %}"
                 aria-label="Visit my {{ profile.network | e }} profile">
                {{ profile.network | e }}
              </a>
            {% endfor %}
          </div>
        </div>
      </header>

      <section aria-labelledby="summary-heading">
        <h3 id="summary-heading">Executive Summary</h3>
        <p>{{ basics.summary | e }}</p>
      </section>

      <section aria-labelledby="skills-heading">
        <h3 id="skills-heading">Core Technical Competencies</h3>
        {% for skill_group in skills %}
          <article class="skill-category">
            <strong>{{ skill_group.name | e }}:</strong>
            <div class="skills-grid">
              {% for keyword in skill_group.keywords %}
                <span>{{ keyword | e }}</span>
              {% endfor %}
            </div>
          </article>
        {% endfor %}
      </section>

      <section aria-labelledby="experience-heading">
        <h3 id="experience-heading">Professional Experience</h3>
        {% for job in work %}
          <article class="job">
            <div class="job-header">
              <h4>{{ job.position | e }} | {{ job.name | e }}</h4>
              <span class="date">{{ job.startDate | e }} &mdash; {{ job.endDate | default('Present', true) | e }}</span>
            </div>
            <p class="job-summary"><em>{{ job.summary | e }}</em></p>
            <ul>
              {% for highlight in job.highlights %}
                <li>{{ highlight | e }}</li>
              {% endfor %}
            </ul>
          </article>
        {% endfor %}
      </section>

      <section aria-labelledby="projects-heading">
        <h3 id="projects-heading">Architectural Projects</h3>
        {% for project in projects %}
          <article class="project">
            <div class="project-header">
              <h4>
                {{ project.name | e }}
                {% if project.url %}
                  <a href="{{ project.url | e }}" target="_blank" rel="noopener noreferrer" class="demo-link" aria-label="Live demo for {{ project.name | e }}">[Live Demo]</a>
                {% endif %}
              </h4>
              <span class="date">{{ project.startDate | e }} &mdash; {{ project.endDate | default('Present', true) | e }}</span>
            </div>
            <p class="project-description">{{ project.description | e }}</p>
            <ul>
              {% for highlight in project.highlights %}
                <li>{{ highlight | e }}</li>
              {% endfor %}
            </ul>
          </article>
        {% endfor %}
      </section>

      <section class="bottom-grid">
        <article aria-labelledby="education-heading">
          <h3 id="education-heading">Education</h3>
          {% for edu in education %}
            <p>
              <strong>{{ edu.studyType | e }} in {{ edu.area | e }}</strong><br />
              {{ edu.institution | e }} | {{ edu.score | e }}<br />
              <span class="date">Graduated: {{ edu.endDate | e }}</span>
            </p>
          {% endfor %}
        </article>
        
        <article aria-labelledby="certs-heading">
          <h3 id="certs-heading">Certifications</h3>
          <ul>
            {% for cert in certificates %}
              <li><strong>{{ cert.name | e }}</strong> ({{ cert.issuer | e }}) - <span class="date">{{ cert.date | e }}</span></li>
            {% endfor %}
          </ul>
        </article>
      </section>
    </main>

    <div class="footer-telemetry" aria-live="polite">
      <p><b>Unique Visitors: <span id="counter">Initializing session...</span></b></p>
    </div>

    <script>
      const counterContainer = document.getElementById('counter');
      // Replace with active API Gateway Invoke URL during AWS provisioning
      const apiURL = 'https://kj49hc8y0a.execute-api.ap-south-1.amazonaws.com/count';

      async function updateCounter() {
        try {
          // SRE Constraint: Implement timeout/abort controller to prevent hanging fetch requests
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), 5000); // 5-second hard timeout
          
          const response = await fetch(apiURL, { signal: controller.signal });
          clearTimeout(timeoutId);
          
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          
          const data = await response.json();
          counterContainer.innerHTML = parseInt(data.count).toLocaleString();
        } catch (error) {
          console.error('Telemetry Fetch Error:', error);
          // Graceful Degradation: Do not expose raw errors to the UI
          counterContainer.innerHTML = 'System Active (Counter Offline)';
        }
      }
      
      // Execute asynchronously without blocking the main render thread
      document.addEventListener('DOMContentLoaded', updateCounter);
    </script>
  </body>
</html>