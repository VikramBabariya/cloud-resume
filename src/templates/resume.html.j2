<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Professional Portfolio and Cloud Resume of {{ basics.name | e }}"
    />
    <title>{{ basics.name | e }} | {{ basics.label | e }}</title>

    <style>
      {{ inline_css }}
    </style>
  </head>
  <body>
    <main class="container">
      <header>
        <h1>{{ basics.name | e }}</h1>
        <h2>{{ basics.label | e }}</h2>
        <div class="contact-info">
          <p>
            {{ basics.email | e }} | {{ basics.phone | default('', true) | e }} |
            {{ basics.location.city | e }}, {{ basics.location.countryCode | e }}
          </p>
          <div class="profiles">
            {% for profile in basics.profiles %}
              <a
                href="{{ profile.url | e }}"
                target="_blank"
                rel="noopener noreferrer"
                class="{% if profile.network | lower == 'linkedin' %}btn btn-primary{% else %}btn btn-secondary{% endif %}"
                aria-label="Visit my {{ profile.network | e }} profile"
              >
                {{ profile.network | e }}
              </a>
            {% endfor %}
            <a
              href="resume.pdf"
              download="{{ basics.name | replace(' ', '_') | e }}_Resume.pdf"
              class="btn btn-download"
              aria-label="Download resume as PDF"
            >
              ↓ Download PDF
            </a>
          </div>
        </div>
      </header>

      <section aria-labelledby="summary-heading">
        <h3 id="summary-heading">Executive Summary</h3>
        <p>{{ basics.summary | render_md }}</p>
      </section>

      <section aria-labelledby="skills-heading">
        <h3 id="skills-heading">Core Technical Competencies</h3>
        {% for skill_group in skills %}
          <article class="skill-category">
            <strong>{{ skill_group.name | e }}:</strong>
            <div class="skills-grid">
              {% for keyword in skill_group.keywords %}
                <span>{{ keyword | e }}</span>
              {% endfor %}
            </div>
          </article>
        {% endfor %}
      </section>

      <section aria-labelledby="profdev-heading">
        <h3 id="profdev-heading">INDEPENDENT CLOUD &amp; PLATFORM ENGINEERING</h3>
        {% for job in work if job.type is defined and job.type == 'sabbatical' %}
          <article class="job">
            <div class="job-header">
              <h4>{{ job.name | e }}</h4>
              <span class="job-location">{{ job.location | e }}</span>
            </div>
            <div class="job-meta">
              <span class="job-company">{{ job.position | e }}</span>
              <span class="date"
                >{{ job.startDate | format_date | e }} &mdash;
                {{ job.endDate | default('Present', true) | format_date | e }}</span>
            </div>
            {% for project in job.projects %}
              <article class="project">
                <div class="project-header">
                  <h4>{{ project.name | e }}</h4>
                  {% if project.url is defined and project.url %}
                    <a
                      href="{{ project.url | e }}"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="demo-link"
                      aria-label="Link for {{ project.name | e }}"
                      >{{ project.url | e }} ↗</a
                    >
                  {% endif %}
                </div>
                {# <div class="project-meta">
                  <span class="project-org">{{ project.description | render_md }}</span>
                </div> #}
                <ul>
                  {% for highlight in project.highlights %}
                    <li>{{ highlight | render_md }}</li>
                  {% endfor %}
                </ul>
              </article>
            {% endfor %}
          </article>
        {% endfor %}
      </section>

      <section aria-labelledby="experience-heading">
        <h3 id="experience-heading">Professional Experience</h3>
        {% set regular_jobs = work | rejectattr('type', 'equalto', 'sabbatical') | list %}
        {% for company, jobs in regular_jobs | groupby('name') %}
          <article class="job">
            <div class="job-header">
              <h4>{{ company | e }}</h4>
              <span class="job-location">{{ (jobs | list)[0].location | e }}</span>
            </div>
            {% for job in jobs %}
              <div class="job-role">
                <div class="job-role-header">
                  <span class="job-position">{{ job.position | e }}</span>
                  <span class="date"
                    >{{ job.startDate | format_date | e }} &mdash;
                    {{ job.endDate | default('Present', true) | format_date | e }}</span
                  >
                </div>
                {% if job.summary %}
                  <p class="job-summary"><em>{{ job.summary | render_md }}</em></p>
                {% endif %}
                <ul>
                  {% for highlight in job.highlights %}
                    <li>{{ highlight | render_md }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endfor %}
          </article>
        {% endfor %}
      </section>

      <section aria-labelledby="edu-cert-heading">
        <div class="bottom-grid" id="edu-cert-heading">
          <article aria-labelledby="education-heading">
            <h4 id="education-heading">Education</h4>
            {% for edu in education %}
              <div class="edu-entry">
                <div class="edu-header">
                  <span class="edu-degree">{{ edu.studyType | e }} in {{ edu.area | e }}</span>
                  <span class="date"
                    >{{ edu.startDate | format_date | e }} – {{ edu.endDate | format_date | e }}</span
                  >
                </div>
                <div class="edu-sub">
                  <span class="edu-institution">{{ edu.institution | e }}</span>
                  <span class="edu-score">{{ edu.score | e }}</span>
                </div>
              </div>
            {% endfor %}
          </article>

          <article aria-labelledby="certs-heading">
            <h4 id="certs-heading">Certifications</h4>
            {% for cert in certificates %}
              <div class="cert-entry">
                <div class="cert-header">
                  <span class="cert-name">{{ cert.name | e }}</span>
                  <span class="date">{{ cert.date | format_date | e }}</span>
                </div>
                <div class="cert-sub">
                  <span class="cert-issuer">{{ cert.issuer | e }}</span>
                </div>
              </div>
            {% endfor %}
          </article>
        </div>
      </section>
    </main>

    <div class="footer-telemetry" aria-live="polite">
      <p><b>Page Views: <span id="counter">Initializing session...</span></b></p>
    </div>

    <script>
      const counterContainer = document.getElementById('counter');
      // API Gateway Invoke URL sourced from data/resume.yaml via build pipeline
      const apiURL = '{{ basics.api_gateway_url | e }}/count';

      async function updateCounter() {
        try {
          // SRE Constraint: Implement timeout/abort controller to prevent hanging fetch requests
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), 5000); // 5-second hard timeout

          const response = await fetch(apiURL, {
            signal: controller.signal,
            method: 'POST',
            mode: 'cors', // Explicitly declare cross-origin intent
            headers: {
              Accept: 'application/json', // Explicitly request a JSON response
            },
          });
          clearTimeout(timeoutId);

          if (!response.ok) throw new Error(`HTTP ${response.status}`);

          const data = await response.json();
          counterContainer.innerHTML = parseInt(data.count).toLocaleString();
        } catch (error) {
          console.error('Telemetry Fetch Error:', error);
          // Graceful Degradation: Do not expose raw errors to the UI
          counterContainer.innerHTML = 'System Active (Counter Offline)';
        }
      }

      // Execute asynchronously without blocking the main render thread
      document.addEventListener('DOMContentLoaded', updateCounter);
    </script>
  </body>
</html>
