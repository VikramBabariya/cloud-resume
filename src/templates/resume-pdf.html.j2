<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{{ basics.name | e }} — Resume</title>
    <style>
      {{ pdf_css }}
    </style>
  </head>
  <body>
    <!-- ================================================================
         HEADER — name, title, single contact line
         ================================================================ -->
    <header>
      <h1>{{ basics.name | e }}</h1>
      <p class="label">{{ basics.label | e }}</p>
      <p class="contact">
        {{ basics.email | e }}
        &nbsp;&nbsp;|&nbsp;&nbsp;
        {{ basics.phone | default("", true) | e }}
        &nbsp;&nbsp;|&nbsp;&nbsp;
        {{ basics.location.city | e }}, {{ basics.location.countryCode | e }}
        &nbsp;&nbsp;|&nbsp;&nbsp;
        <a href="{{ basics.url | e }}" class="contact-link">Portfolio</a>
        {% for profile in basics.profiles %}
          &nbsp;&nbsp;|&nbsp;&nbsp;<a href="{{ profile.url | e }}" class="contact-link">{{ profile.network | e }}</a>
        {% endfor %}
      </p>
    </header>

    <!-- ================================================================
         EXECUTIVE SUMMARY
         ================================================================ -->
    <section>
      <h2>Executive Summary</h2>
      <p class="summary-text">{{ basics.summary | strip_md }}</p>
    </section>

    <!-- ================================================================
         CORE TECHNICAL COMPETENCIES
         ================================================================ -->
    <section>
      <h2>Core Technical Competencies</h2>
      {% for skill_group in skills %}
        <p class="skill-row">
          <span class="skill-name">{{ skill_group.name | e }}:</span>
          {{ skill_group.keywords | join(", ") | e }}
        </p>
      {% endfor %}
    </section>

    <!-- ================================================================
         PROFESSIONAL DEVELOPMENT (CLOUD & DEVOPS ENGINEERING)
         ================================================================ -->
    <section>
      <h2>INDEPENDENT CLOUD &amp; PLATFORM ENGINEERING</h2>
      {% for job in work if job.type is defined and job.type == 'sabbatical' %}
        <div class="entry">
          <div class="entry-header">
            <span class="entry-title">{{ job.name | e }}</span>
            <span class="entry-date">
              {{ job.startDate | format_date | e }} –
              {{ job.endDate | default("Present", true) | format_date | e }}
            </span>
          </div>
          <div class="entry-sub">
            <span class="entry-org">{{ job.position | e }}</span>
            <span class="entry-location">{{ job.location | e }}</span>
          </div>
          {% for project in job.projects %}
            <div class="entry" style="margin-top: 6pt;">
              <div class="entry-header">
                <span class="entry-title">{{ project.name | e }}</span>
                {% if project.url is defined and project.url %}
                  <a href="{{ project.url | e }}" class="entry-link">{% if 'github.com' in project.url %}GitHub ↗{% else %}Live ↗{% endif %}</a>
                {% endif %}
              </div>
              {# {% if project.description is defined and project.description %}
                <div class="entry-sub">
                  <span class="entry-org">{{ project.description | strip_md }}</span>
                </div>
              {% endif %} #}
              <ul>
                {% for highlight in project.highlights %}
                  <li>{{ highlight | strip_md }}</li>
                {% endfor %}
              </ul>
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    </section>

    <!-- ================================================================
         PROFESSIONAL EXPERIENCE
         ================================================================ -->
    <section>
      <h2>Professional Experience</h2>
      {% set regular_jobs = work | rejectattr('type', 'equalto', 'sabbatical') | list %}
      {% for company, jobs in regular_jobs | groupby('name') %}
        <div class="entry">
          <div class="entry-header">
            <span class="entry-title">{{ company | e }}</span>
            <span class="entry-location">{{ (jobs | list)[0].location | e }}</span>
          </div>
          {% for job in jobs %}
            <div class="job-role">
              <div class="entry-header" style="margin-top: 4pt;">
                <span class="entry-org">{{ job.position | e }}</span>
                <span class="entry-date">
                  {{ job.startDate | format_date | e }} –
                  {{ job.endDate | default("Present", true) | format_date | e }}
                </span>
              </div>
              {% if job.summary is defined and job.summary %}
                <p class="entry-summary">{{ job.summary | strip_md }}</p>
              {% endif %}
              <ul>
                {% for highlight in job.highlights %}
                  <li>{{ highlight | strip_md }}</li>
                {% endfor %}
              </ul>
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    </section>

    <!-- ================================================================
         EDUCATION & CERTIFICATIONS — combined single section,
         one line per entry (avoids WeasyPrint multi-column page-break issues)
         ================================================================ -->
    <section>
      <h2>Education &amp; Certifications</h2>
      {% for edu in education %}
        <div class="entry">
          <div class="entry-header">
            <span class="entry-title">{{ edu.studyType | e }} in {{ edu.area | e }}</span>
            <span class="entry-date">
              {{ edu.startDate | format_date | e }} – {{ edu.endDate | format_date | e }}
            </span>
          </div>
          <div class="entry-sub">
            <span class="entry-org">{{ edu.institution | e }}</span>
            <span class="entry-location">{{ edu.score | e }}</span>
          </div>
        </div>
      {% endfor %}
      {% for cert in certificates %}
        <div class="entry">
          <div class="entry-header">
            <span class="entry-title">{{ cert.name | e }}</span>
            <span class="entry-date">{{ cert.date | format_date | e }}</span>
          </div>
          <div class="entry-sub">
            <span class="entry-org">{{ cert.issuer | e }}</span>
          </div>
        </div>
      {% endfor %}
    </section>
  </body>
</html>
